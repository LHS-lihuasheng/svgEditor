**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows系统文件
**/Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux系统文件
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

#----------------------------------------------
# 开发环境文件
#----------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# 保留示例环境文件
!.env/example
# 或者如果是 .env.example 文件
!.env.example

